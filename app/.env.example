# Example configuration for the simultaneous translation app.
# Copy to `.env` and adjust. All values are optional; defaults (shown) are applied
# when a variable is unset. `.env` is gitignored — never commit real secrets.
#
# Source of truth: app/src/config.ts

# ── General ───────────────────────────────────────────────────────────────
AWS_REGION=ap-northeast-1
LOG_LEVEL=info                      # debug | info | warn | error

# ── SRT ingest (app is the SRT listener; OBS connects as caller) ────────────
SRT_HOST=127.0.0.1                  # bind address; loopback for local runs (the Fargate task sets 0.0.0.0)
SRT_PORT=9000
SRT_LATENCY_MS=120                  # SRT buffer; higher = more loss-resilience, more delay
# SECRET — set via environment / AWS Secrets Manager, not committed.
SRT_PASSPHRASE=                     # empty = no encryption (local test only)
SRT_ANALYZE_MS=500                  # ffmpeg input probing of the SRT stream (ms); 0 = ffmpeg default (~5 s start-up burst; revert)

# ── Audio sent to Transcribe (validated: 16 kHz mono s16le) ─────────────────
SAMPLE_RATE=16000
FRAME_BYTES=3200                    # Transcribe frame size (~100ms)

# ── Amazon Transcribe (speech-to-text) ──────────────────────────────────────
SOURCE_LANGUAGE=en-US
TRANSCRIBE_VOCABULARY=              # custom vocabulary name (optional; see dictionaries/)
PARTIAL_STABILITY=high              # low | medium | high
# ── Language filter (ignore Japanese moderator / audience questions) ─────────
# langid = Transcribe multi-language ID; only SOURCE_LANGUAGE results are translated.
# off    = REVERT SWITCH: single-language en-US request (everything is translated).
LANGUAGE_FILTER=langid
LANGUAGE_OPTIONS=en-US,ja-JP        # 2-5 codes, one per language, must include SOURCE_LANGUAGE
LANGID_SETTLE_WORDS=5               # stable words before an English result is committed (fixed mode)
LANGID_SETTLE_MODE=fixed            # fixed = LANGID_SETTLE_WORDS for every result | dynamic = 3 words, 5 for a while after Japanese
LANGID_SETTLE_WORDS_DEFAULT=3       # dynamic: stable words when no Japanese result was seen recently
LANGID_SETTLE_WORDS_AFTER_JA=5      # dynamic: stable words within LANGID_JA_MEMORY_MS after a Japanese result
LANGID_JA_MEMORY_MS=60000           # dynamic: how long a Japanese result keeps the longer threshold
LANGID_SHORT_WORDS=4                # drop <= N-word low-confidence English right after Japanese (0 = off)
LANGID_SHORT_MIN_CONF=0.6           # mean confidence threshold for that rule

# ── Segmentation (when to send English text to Translate) ───────────────────
# clause   = translate mid-sentence in clause-sized chunks (lower latency)
# sentence = REVERT SWITCH: translate whole sentences (previous behaviour, higher latency).
#            Also set MAX_BACKLOG_MS=0: with the default 10 s cap, sentence mode drops whole
#            sentences under sustained speech. Full revert: add SPEED_MODE=off FILLER_FILTER=off.
SEGMENTATION_MODE=clause
CHUNK_MIN_WORDS=5                   # min words (fillers excluded) before comma/conjunction/max-time cut
CHUNK_MAX_WORDS=14                  # hard word cap per chunk (clause mode)
CHUNK_MAX_MS=3000                   # flush a chunk open this long once >= min words; 0 disables
CHUNK_PAUSE_MS=1200                 # flush pending stable words after this much transcript silence; 0 disables
CHUNK_CONJUNCTIONS=and,but,so,because,which,who,where,when,while,although,though,if,unless,or,then
# Merge short sentences (clause mode only): a sentence end (.?!) or Transcribe final that would give a
# chunk with fewer than SENTENCE_MIN_WORDS words is held and joined with the following text.
# MERGE_SHORT=off reverts to cutting at every sentence end / final.
MERGE_SHORT=on                      # on | off (main switch)
SENTENCE_MIN_WORDS=8                # min words (fillers excluded) for a sentence/final cut
SENTENCE_COMPLETE_WORDS=5           # merge on: a .?! sentence of >= N words is never held; 0 = revert
MERGE_PAUSE_MS=1500                 # release held text after this much transcript silence; 0 disables
MERGE_MAX_HOLD_MS=6000              # safety valve: release held text once its oldest word is this old (1000-60000)
# Quality v1 (each part has its own revert)
DANGLING_GUARD=on                   # on | off (revert): never end a chunk on a word like "to", "the", "that"
DANGLING_WORDS=                     # comma list; empty = built-in list
DANGLING_MAX_WORDS=2                # extra words CHUNK_MAX_WORDS may grow by (0-20)
DANGLING_MAX_HOLD_MS=500            # longest wait of a pause/final cut after a dangling word (0-10000)
CUT_LOOKAHEAD_MS=0                  # mid-sentence pause/final cut waits this long for the next word; 0 = revert (0-5000)
SHORT_SENTENCE_JOIN=on              # on | off (revert): join tiny held sentences with commas for Translate
SHORT_SENTENCE_WORDS=3              # max words of a tiny sentence (1-6)
SHORT_JOIN_PAUSE_MS=1000            # silence that releases tiny held sentences; 0 = use MERGE_PAUSE_MS (0-10000)
ENABLE_CORRECTION=true              # apply post-recognition correction map
# ── Filler removal (never translate/speak "um" → ええと, "you know" → ご存知のとおり) ──
FILLER_FILTER=on                    # on | off (main switch)
FILLER_WORDS=um,uh,er,ah,hmm,mm,erm,uh-huh   # always removed (whole words)
# Removed only as discourse markers: at chunk/sentence start followed by a comma or nothing,
# or set off by commas. Literal uses ("do you know", "works well", "I'd like") are kept.
FILLER_PHRASES=you know,I mean,well,like,sort of,kind of,you see,okay so,so yeah
# Japanese safety net after Translate: stripped (with trailing 、) only at the start or after
# 。/、 and only when followed by 、/。/end; a pattern ending in 、 matches only at sentence start.
JA_FILLER_PATTERNS=ええと,えーと,えっと,えー,あの,あのー,まあ,ご存知のとおり,ご存知のように,ご存じのとおり,ご存じのように,ほら,つまり、
# ── Playback (in order; a chunk that started playing is never cut) ──────────
# backlogMs = how late a chunk's Japanese would start relative to its last English word.
# Polly speed: levels (default) = graded levels with smoothing; steps = previous SPEEDUP_STEPS behaviour
# exactly (revert switch); off = always 100%.
SPEED_MODE=levels
SPEED_LEVELS=100,110,120,130,145    # rate % of L1..Ln: 2-10 ascending integers 100-200
SPEED_THRESHOLDS_MS=3000,4500,6000,7500   # signal (ms) to enter L2..Ln: levels-1 ascending integers 0-60000
SPEED_HYSTERESIS_MS=1500            # going down from Li needs signal < threshold(Li) - this
SPEED_HOLD_MS=8000                  # audio ms at the current level before the next change (0 = no hold)
SPEED_URGENT_MS=10000               # signal >= this jumps straight up to the target level (0 = never)
SPEED_LOOKAHEAD=1                   # weight of max(0, estimated JA ms - EN chunk ms) in the signal, 0-2 (0 = off)
SPEED_MS_PER_CHAR=165               # estimated JA audio ms per spoken char at 100% (calibrated: Kazuha neural)
SPEED_RESET_GAP_MS=3000             # output idle >= this before a chunk: step down straight to the target (0 = never)
SPEEDUP_STEPS=3000:115,5000:130,7000:150   # SPEED_MODE=steps only: "backlogMs:rate%,..."; "off" disables
MAX_BACKLOG_MS=10000                # drop whole queued chunks (oldest first, newest always kept) that would start later than this; 0 = never drop
AWS_CALL_TIMEOUT_MS=8000            # per-call timeout for Translate / Polly (SDK retries up to 3 attempts)

# ── Amazon Translate (English → Japanese) ───────────────────────────────────
TRANSLATE_SOURCE=en
TRANSLATE_TARGET=ja
TRANSLATE_FORMALITY=FORMAL          # FORMAL | INFORMAL | off (off = revert; parameter not sent)
TRANSLATE_TERMINOLOGY=              # custom terminology name (optional; see dictionaries/). Also the glossary source of the LLM engine
TRANSLATE_ENGINE=translate          # translate | llm. llm = Bedrock LLM per chunk, Amazon Translate stays the per-chunk fallback (revert: translate)

# ── LLM engine (only used when TRANSLATE_ENGINE=llm; see README "LLM translation engine") ─
LLM_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0   # Japan cross-region inference profile (bare model IDs fail)
LLM_TIMEOUT_MS=1500                 # 200-10000; per-call limit, then Translate (benchmark warm p90 795 ms)
LLM_CONTEXT_CHUNKS=3                # 0-6; previous chunks (English sent + Japanese spoken) given as context; 0 = none
LLM_CONTEXT_RESET_MS=60000          # 0-600000; clear the context after this much source-time silence (and at a new session); 0 = never
LLM_GLOSSARY=full                   # full | off; full = whole terminology in the cached system prompt (needs translate:GetTerminology), off = none and no cache
LLM_MAX_TOKENS=400                  # 48-1000; ceiling of clamp(4 x English words, 48, cap)
LLM_BREAKER_MS=30000                # 1000-600000; circuit breaker open time (Translate only), then one trial call
LLM_SKIP_BACKLOG_MS=0               # 0-60000; backlog above this sends that chunk to Translate; 0 = off
LLM_PARALLEL_FALLBACK=off           # off | on; on = start Translate in parallel with the LLM call (about $1 more per 4 h session)
LLM_MAX_CHARS_PER_WORD=15           # 4-40; validation upper bound ceil(value x words) + 10 Japanese characters
LLM_KEEPWARM_MS=240000              # 0 (off) or 30000-290000; dummy call when no LLM call for this long (prompt cache TTL is 5 min)

# ── Amazon Polly (text-to-speech) ───────────────────────────────────────────
POLLY_READINGS=on                   # on | off: SSML <sub alias> pronunciation readings (text itself is never changed)
#POLLY_READINGS_FILE=               # default: assets/polly-readings.csv (bundled in the image)
POLLY_VOICE=Kazuha                  # a Japanese neural voice (e.g. Kazuha, Tomoko)
POLLY_ENGINE=neural                 # neural | standard
POLLY_SAMPLE_RATE=16000

# ── LiveKit (egress) ────────────────────────────────────────────────────────
LIVEKIT_URL=ws://127.0.0.1:7880     # use wss:// in production
LIVEKIT_API_KEY=devkey
# SECRET — set via environment / AWS Secrets Manager, not committed.
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM=translation
LIVEKIT_TOKEN_TTL=4h

# ── Local testing only ──────────────────────────────────────────────────────
# If set, the app reads/paces this raw PCM file (16 kHz mono s16le) instead of
# listening for a live SRT stream. Leave unset for the live SRT path.
# INPUT_FILE=sample.raw
# INPUT_FILE pacing: absolute (default; frame k at start + k*100 ms) | sleep (old; drifts ~1 %, +2.5 s after 4 min)
# INPUT_PACING=absolute
# Audio output: livekit (default, production) | file (writes raw s16le PCM to OUTPUT_FILE,
# paced like LiveKit; no LiveKit server needed). Never set this in production.
# AUDIO_SINK=file
# OUTPUT_FILE=out.pcm

# Health-check HTTP port (Fargate/ALB probe). Default 8080.
# HEALTH_PORT=8080
# Health-check bind address. Default 127.0.0.1 (loopback); the Fargate task sets 0.0.0.0
# explicitly because the NLB health check needs it.
# HEALTH_HOST=127.0.0.1
