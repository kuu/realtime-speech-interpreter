{
  "name": "simul-translation-app",
  "version": "0.1.0",
  "private": true,
  "description": "SRT ingest → Transcribe → Translate → Polly → LiveKit publisher",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "token": "tsx src/tools/make-token.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "probe:llm": "tsx src/tools/llm-probe.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.658.0",
    "@aws-sdk/client-polly": "^3.658.0",
    "@aws-sdk/client-ssm": "^3.1169.0",
    "@aws-sdk/client-transcribe-streaming": "^3.658.0",
    "@aws-sdk/client-translate": "^3.658.0",
    "@livekit/rtc-node": "^0.13.0",
    "livekit-server-sdk": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
