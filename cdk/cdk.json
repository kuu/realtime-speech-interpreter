{
  "app": "npx ts-node --prefer-ts-exts bin/simul-translation.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules",
      "cdk.out",
      "scripts"
    ]
  },
  "context": {
    "region": "ap-northeast-1",
    "latencyPreset": "default",
    "appPath": "../app",
    "srtPort": 9000,
    "srtLatencyMs": 120,
    "srtListenTimeoutSec": 86400,
    "srtAnalyzeMs": 500,
    "healthPort": 8080,
    "sampleRate": 16000,
    "frameBytes": 3200,
    "sourceLanguage": "en-US",
    "partialStability": "high",
    "languageFilter": "langid",
    "languageOptions": "en-US,ja-JP",
    "langidSettleWords": 5,
    "langidSettleMode": "fixed",
    "langidSettleWordsDefault": 3,
    "langidSettleWordsAfterJa": 5,
    "langidJaMemoryMs": 60000,
    "langidShortWords": 4,
    "langidShortMinConf": 0.6,
    "segmentationMode": "clause",
    "chunkMinWords": 8,
    "chunkMaxWords": 22,
    "chunkMaxMs": 0,
    "chunkPauseMs": 900,
    "chunkConjunctions": "because,but,although,though,while,which",
    "mergeShort": "on",
    "sentenceMinWords": 8,
    "sentenceCompleteWords": 5,
    "mergePauseMs": 1500,
    "mergeMaxHoldMs": 6000,
    "danglingGuard": "on",
    "danglingWords": "",
    "danglingMaxWords": 2,
    "danglingMaxHoldMs": 500,
    "cutLookaheadMs": 0,
    "shortSentenceJoin": "on",
    "shortSentenceWords": 3,
    "shortJoinPauseMs": 1000,
    "speedupSteps": "3000:115,5000:130,7000:150",
    "speedMode": "levels",
    "speedLevels": "100,110,120,130,145",
    "speedThresholdsMs": "3000,4500,6000,7500",
    "speedHysteresisMs": 1500,
    "speedHoldMs": 8000,
    "speedUrgentMs": 10000,
    "speedLookahead": 1,
    "speedMsPerChar": 165,
    "speedResetGapMs": 3000,
    "maxBacklogMs": 15000,
    "fillerFilter": "on",
    "fillerWords": "um,uh,er,ah,hmm,mm,erm,uh-huh",
    "fillerPhrases": "you know,I mean,well,like,sort of,kind of,you see,okay so,so yeah",
    "jaFillerPatterns": "ええと,えーと,えっと,えー,あの,あのー,まあ,ご存知のとおり,ご存知のように,ご存じのとおり,ご存じのように,ほら,つまり、",
    "enableCorrection": "true",
    "translateSource": "en",
    "translateTarget": "ja",
    "translateFormality": "FORMAL",
    "translateEngine": "translate",
    "llmModelId": "jp.anthropic.claude-haiku-4-5-20251001-v1:0",
    "llmTimeoutMs": 1500,
    "llmContextChunks": 3,
    "llmContextResetMs": 60000,
    "llmGlossary": "full",
    "llmMaxTokens": 400,
    "llmBreakerMs": 30000,
    "llmSkipBacklogMs": 0,
    "llmParallelFallback": "off",
    "llmMaxCharsPerWord": 15,
    "llmKeepWarmMs": 240000,
    "llmPromptVersion": 2,
    "transcribeVocabularyName": "simul-translation",
    "translateTerminologyName": "simul-translation",
    "pollyVoice": "Kazuha",
    "pollyEngine": "neural",
    "pollySampleRate": 16000,
    "pollyReadings": "on",
    "captions": "on",
    "captionsJapaneseSpeech": "on",
    "roomName": "translation",
    "publisherTokenTtl": "6h",
    "listenerTokenTtlSec": 21600,
    "livekitApiKey": "simulkey",
    "livekitHostname": "",
    "livekitInstanceType": "c6i.large",
    "livekitImage": "livekit/livekit-server:v1.13.11",
    "caddyImage": "caddy:2.11.7",
    "livekitUdpPortStart": 50000,
    "livekitUdpPortEnd": 60000,
    "livekitTcpPort": 7881,
    "taskCpu": 1024,
    "taskMemoryMiB": 2048,
    "desiredCount": 1,
    "logLevel": "info",
    "logRetentionDays": 14,
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws"],
    "@aws-cdk/aws-ec2:uniqueImdsv2TemplateName": true,
    "@aws-cdk/aws-ecs:arnFormatIncludesClusterName": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-s3:serverAccessLogsUseBucketPolicy": true,
    "@aws-cdk/aws-ec2:restrictDefaultSecurityGroup": true,
    "@aws-cdk/aws-ecs:removeDefaultDeploymentAlarm": true,
    "@aws-cdk/aws-ecs:disableExplicitDeploymentControllerForCircuitBreaker": true,
    "@aws-cdk/aws-ec2:ebsDefaultGp3Volume": true,
    "@aws-cdk/aws-s3:keepNotificationInImportedBucket": false,
    "@aws-cdk/aws-lambda:useCdkManagedLogGroup": true
  }
}
