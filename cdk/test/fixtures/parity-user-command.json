  "LiveKitInstanceF48113A9583db718bc3d8122": {
    "Type": "AWS::EC2::Instance",
    "Properties": {
      "AvailabilityZone": {
        "Fn::Select": [
          0,
          {
            "Fn::GetAZs": ""
          }
        ]
      },
      "BlockDeviceMappings": [
        {
          "DeviceName": "/dev/xvda",
          "Ebs": {
            "Encrypted": true,
            "VolumeSize": 20,
            "VolumeType": "gp3"
          }
        }
      ],
      "IamInstanceProfile": {
        "Ref": "LiveKitInstanceInstanceProfileC5EA796B"
      },
      "ImageId": {
        "Ref": "SsmParameterValueawsserviceamiamazonlinuxlatestal2023amikernel61x8664C96584B6F00A464EAD1953AFF4B05118Parameter"
      },
      "InstanceType": "c6i.large",
      "LaunchTemplate": {
        "LaunchTemplateName": "SimulTranslationLiveKitInstanceLaunchTemplate97AA4B69",
        "Version": {
          "Fn::GetAtt": [
            "LiveKitInstanceLaunchTemplateF3895EBF",
            "LatestVersionNumber"
          ]
        }
      },
      "NetworkInterfaces": [
        {
          "AssociatePublicIpAddress": true,
          "DeviceIndex": "0",
          "GroupSet": [
            {
              "Fn::GetAtt": [
                "LiveKitSg725ABC44",
                "GroupId"
              ]
            }
          ],
          "SubnetId": {
            "Ref": "VpcpublicSubnet1Subnet2BB74ED7"
          }
        }
      ],
      "Tags": [
        {
          "Key": "Name",
          "Value": "simul-translation-livekit"
        }
      ],
      "UserData": {
        "Fn::Base64": {
          "Fn::Join": [
            "",
            [
              "#!/bin/bash\nset -euxo pipefail\ndnf install -y docker\nsystemctl enable --now docker\nset +x\nSECRET_JSON=$(aws secretsmanager get-secret-value --region ",
              {
                "Ref": "AWS::Region"
              },
              " --secret-id '",
              {
                "Ref": "LiveKitApiSecret99FDFFD0"
              },
              "' --query SecretString --output text)\nAPI_KEY=$(printf '%s' \"$SECRET_JSON\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"apiKey\"])')\nAPI_SECRET=$(printf '%s' \"$SECRET_JSON\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"apiSecret\"])')\nunset SECRET_JSON\nmkdir -p /etc/livekit /etc/caddy\numask 077\ncat > /etc/livekit/livekit.yaml <<EOF\nport: 7880\nbind_addresses: [\"127.0.0.1\"]\nrtc:\n  tcp_port: 7881\n  port_range_start: 50000\n  port_range_end: 60000\n  use_external_ip: false\n  node_ip: ",
              {
                "Ref": "LiveKitEip"
              },
              "\nkeys:\n  $API_KEY: $API_SECRET\nlogging:\n  level: info\nEOF\nunset API_KEY API_SECRET\nset -x\numask 022\ncat > /etc/caddy/Caddyfile <<'EOF'\n{\n  auto_https disable_redirects\n}\n",
              {
                "Ref": "LiveKitEip"
              },
              ".sslip.io:443 {\n  tls {\n    issuer acme {\n      disable_http_challenge\n    }\n  }\n  reverse_proxy 127.0.0.1:7880\n}\nEOF\ndocker run -d --name livekit --restart unless-stopped --network host --log-driver awslogs --log-opt awslogs-region=",
              {
                "Ref": "AWS::Region"
              },
              " --log-opt awslogs-group=",
              {
                "Ref": "LiveKitLogGroup36FB661D"
              },
              " --log-opt awslogs-stream=livekit -v /etc/livekit/livekit.yaml:/etc/livekit.yaml:ro livekit/livekit-server:v1.13.11 --config /etc/livekit.yaml\ndocker run -d --name caddy --restart unless-stopped --network host --log-driver awslogs --log-opt awslogs-region=",
              {
                "Ref": "AWS::Region"
              },
              " --log-opt awslogs-group=",
              {
                "Ref": "LiveKitLogGroup36FB661D"
              },
              " --log-opt awslogs-stream=caddy -v /etc/caddy/Caddyfile:/etc/caddy/Caddyfile:ro -v caddy_data:/data -v caddy_config:/config caddy:2.11.7"
            ]
          ]
        }
      }
    }
  },
