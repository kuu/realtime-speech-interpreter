        <mxCell id="title" value="Realtime Speech Interpreter: architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="800" height="32" as="geometry"/></mxCell>
