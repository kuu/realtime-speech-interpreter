        <mxCell id="e_s1" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;strokeWidth=1.4;strokeColor=#8896A5;dashed=1;dashPattern=5 4;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#232F3E;labelBorderColor=#ffffff;" edge="1" parent="1" source="n_app" target="n_secrets"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_s2" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;strokeWidth=1.4;strokeColor=#8896A5;dashed=1;dashPattern=5 4;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#232F3E;labelBorderColor=#ffffff;" edge="1" parent="1" source="n_livekit" target="n_secrets"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_s3e" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;strokeWidth=1.4;strokeColor=#8896A5;dashed=1;dashPattern=5 4;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#232F3E;labelBorderColor=#ffffff;" edge="1" parent="1" source="n_lambda" target="n_secrets"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_s4" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;strokeWidth=1.4;strokeColor=#8896A5;dashed=1;dashPattern=5 4;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#232F3E;labelBorderColor=#ffffff;" edge="1" parent="1" source="n_app" target="n_cloudwatch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_s5" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=none;strokeWidth=1.4;strokeColor=#8896A5;dashed=1;dashPattern=2 3;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#232F3E;labelBorderColor=#ffffff;" edge="1" parent="1" source="n_livekit" target="n_eip"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend: numbered flow&lt;/b&gt;&lt;br&gt;1. Audio line out from the mixer goes into OBS (or any SRT encoder).&lt;br&gt;2. OBS sends SRT with Opus audio over the internet to the load balancer (UDP, venue IP only).&lt;br&gt;3. The load balancer passes it to the Fargate app. ffmpeg decodes it to 16 kHz PCM.&lt;br&gt;4. The app streams the audio to Transcribe streaming, with language identification.&lt;br&gt;5. Transcribe returns text. The app drops non-English results and cuts chunks.&lt;br&gt;6. Translate (default) or a Bedrock model (optional, dashed) translates each chunk.&lt;br&gt;7. Polly speaks the Japanese text, with readings for product names.&lt;br&gt;8. The app publishes the audio to LiveKit over WebRTC (Opus).&lt;br&gt;9. The listener's browser plays the audio from LiveKit (subscribe only).&lt;br&gt;10. The browser loads the page from CloudFront and asks for a token.&lt;br&gt;11. CloudFront serves the page from a private S3 bucket.&lt;br&gt;12. CloudFront calls the token Lambda, which returns a subscribe-only token.&lt;br&gt;&lt;i&gt;Dashed grey lines: secrets are read from Secrets Manager (app, LiveKit host, token Lambda); app, LiveKit and Lambda logs go to CloudWatch Logs.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fillColor=#F7F8FA;strokeColor=#C7CFD8;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="1007" width="1360" height="286" as="geometry"/></mxCell>
        <mxCell id="footer" value="Simplified tiles, not the official AWS Architecture Icons. AWS service names are trademarks of Amazon.com, Inc. or its affiliates. Unofficial open-source project." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5A6C86;" vertex="1" parent="1"><mxGeometry x="20" y="1249" width="1360" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
