  "edges": [
    {
      "id": "e1",
      "from": "mixer",
      "to": "obs",
      "step": 1,
      "text": "Audio line out from the mixer goes into OBS (or any SRT encoder)."
    },
    {
      "id": "e2",
      "from": "obs",
      "to": "nlb",
      "step": 2,
      "t": 0.3,
      "text": "OBS sends SRT with Opus audio over the internet to the load balancer (UDP, venue IP only)."
    },
    {
      "id": "e3",
      "from": "nlb",
      "to": "app",
      "step": 3,
      "text": "The load balancer passes it to the Fargate app. ffmpeg decodes it to 16 kHz PCM."
    },
    {
      "id": "e4",
      "from": "app",
      "to": "transcribe",
      "step": 4,
      "offset": -9,
      "t": 0.3,
      "text": "The app streams the audio to Transcribe streaming, with language identification."
    },
    {
      "id": "e5",
      "from": "transcribe",
      "to": "app",
      "step": 5,
      "offset": -9,
      "t": 0.7,
      "text": "Transcribe returns text. The app drops non-English results and cuts chunks."
    },
    {
      "id": "e6",
      "from": "app",
      "to": "translate",
      "step": 6,
      "text": "Translate (default) or a Bedrock model (optional, dashed) translates each chunk."
    },
    {
      "id": "e6b",
      "from": "app",
      "to": "bedrock",
      "variantOf": 6,
      "optional": true
    },
    {
      "id": "e7",
      "from": "app",
      "to": "polly",
      "step": 7,
      "text": "Polly speaks the Japanese text, with readings for product names."
    },
    {
      "id": "e8",
      "from": "app",
      "to": "livekit",
      "step": 8,
      "text": "The app publishes the audio to LiveKit over WebRTC (Opus), and the caption text as data packets."
    },
    {
      "id": "e9",
      "from": "livekit",
      "to": "browser",
      "step": 9,
      "t": 0.4,
      "text": "The listener's browser plays the audio and shows the captions from LiveKit (subscribe only)."
    },
    {
      "id": "e10",
      "from": "browser",
      "to": "cloudfront",
      "step": 10,
      "t": 0.45,
      "text": "The browser loads the page from CloudFront and asks for a token."
    },
    {
      "id": "e11",
      "from": "cloudfront",
      "to": "s3",
      "step": 11,
      "text": "CloudFront serves the page from a private S3 bucket."
    },
    {
      "id": "e12",
      "from": "cloudfront",
      "to": "lambda",
      "step": 12,
      "text": "CloudFront calls the token Lambda, which returns a subscribe-only token."
    },
    {
      "id": "s1",
      "from": "app",
      "to": "secrets",
      "style": "support"
    },
    {
      "id": "s2",
      "from": "livekit",
      "to": "secrets",
      "style": "support"
    },
    {
      "id": "s3e",
      "from": "lambda",
      "to": "secrets",
      "style": "support"
    },
    {
      "id": "s4",
      "from": "app",
      "to": "cloudwatch",
      "style": "support"
    },
    {
      "id": "s5",
      "from": "livekit",
      "to": "eip",
      "style": "assoc"
    }
  ],
